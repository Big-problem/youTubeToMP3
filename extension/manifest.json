{
  "manifest_version": 3,
  "name": "YouTube to MP3 Convertor",
  "version": "1.0",
  "description": "一鍵將當前 YouTube 影片轉成 MP3",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}